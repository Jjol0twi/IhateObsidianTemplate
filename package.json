{
  "name": "ihate-template",
  "version": "0.3.0",
  "description": "Create consistent Obsidian notes with explicit templates and workflow tools.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs development --watch",
    "build": "node esbuild.config.mjs release",
    "release:check": "node scripts/check-release.mjs",
    "test": "node --test scripts/test-template-engine.mjs scripts/test-code-tabs.mjs scripts/test-wide-tables.mjs",
    "typecheck": "tsc --noEmit",
    "version:set": "node scripts/set-version.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "template"
  ],
  "author": "hongham",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "latest",
    "@types/prismjs": "1.26.6",
    "builtin-modules": "latest",
    "esbuild": "latest",
    "obsidian": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "marked": "18.1.0"
  }
}
